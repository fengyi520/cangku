{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "incremental": false,
    "types": ["node", "jest", "express", "multer"]
  },
  "include": ["src/**/*.ts", "src/**/*.spec.ts"]
}
