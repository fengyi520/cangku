{
  "name": "cangku",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @cangku/contracts build && pnpm --parallel --filter @cangku/api --filter @cangku/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @cangku/web test:e2e",
    "db:generate": "pnpm --filter @cangku/api prisma:generate",
    "db:migrate": "pnpm --filter @cangku/api prisma:migrate",
    "db:seed": "pnpm --filter @cangku/api prisma:seed"
  }
}
